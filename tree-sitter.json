{
  "grammars": [
    {
      "name": "vix",
      "camelcase": "Vix",
      "scope": "source.vix",
      "path": ".",
      "file-types": [
        "vix"
      ],
      "highlights": "queries/highlights.scm",
      "injection-regex": "^vix$"
    }
  ],
  "metadata": {
    "version": "0.2.0",
    "license": "MIT OR Apache-2.0",
    "description": "Vix grammar for tree-sitter",
    "authors": [
      {
        "name": "Amos Wenger",
        "email": "amos@bearcove.eu"
      }
    ],
    "links": {
      "repository": "https://github.com/vixenware/vix-treesitter"
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false
  }
}
